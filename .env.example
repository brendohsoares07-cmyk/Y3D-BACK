# Copie para .env (cp .env.example .env) e troque os valores. Nunca versione o .env.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=y3d
DB_USER=y3d_user
DB_PASSWORD=troque-esta-senha

# Gere um segredo longo, ex.: openssl rand -hex 32
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_SECONDS=7200

# E-mails (separados por vírgula) que são administradores.
ADMIN_EMAILS=admin@exemplo.com
